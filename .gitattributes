# 统一换行符为 LF，避免 Windows 提交引入 CRLF 差异
* text=auto eol=lf

# 显式声明文本文件类型
*.md   text
*.yml  text
*.yaml text
*.sh   text eol=lf
*.json text
*.txt  text
*.cfg  text
*.ini  text

# 二进制文件不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.whl  binary
